import React, { useEffect, useState } from "react";
import axios from "axios";

const Api = () => {
    const [user, setUser] = useState([]);
    const [loading, setLoading] = useState(true);
    const [search, setSearch] = useState("");
    const [newItem, setNewItem] = useState("");
    const [currentPage, setCurrentPage] = useState(1);
    const [debounce, setDebounce] = useState("");
    const [editId, setEditId] = useState(null);
    const [editText, setEditText] = useState("");

    // GET: Fetch todos
    useEffect(() => {
        axios
            .get("https://jsonplaceholder.typicode.com/todos")
            .then((res) => {
                setUser(res.data);
            })
            .catch((error) => {
                console.log(error);
            })
            .finally(() => {
                setLoading(false);
            });
    }, []);

    // DELETE: Remove todo from API and state
    const handleDelete = (id) => {
        axios
            .delete(
                `https://jsonplaceholder.typicode.com/todos/${id}`
            )
            .then(() => {
                setUser((prev) =>
                    prev.filter((data) => data.id !== id)
                );
            })
            .catch((error) => {
                console.log(error);
            });
    };

    // POST: Add new todo
    const handleAdd = () => {
        if (newItem.trim() === "") return;

        const newData = {
            title: newItem,
            completed: false,
            userId: 1,
        };

        axios
            .post(
                "https://jsonplaceholder.typicode.com/todos",
                newData
            )
            .then((res) => {
                setUser((prev) => [
                    res.data,
                    ...prev,
                ]);

                setNewItem("");
                setCurrentPage(1);
            })
            .catch((error) => {
                console.log(error);
            });
    };

    // Debounce search input
    useEffect(() => {
        const timer = setTimeout(() => {
            setDebounce(search);
        }, 500);

        return () => clearTimeout(timer);
    }, [search]);

    // Filter before pagination
    const filtered = user.filter((data) =>
        data.title
            .toLowerCase()
            .includes(debounce.trim().toLowerCase())
    );

    // Pagination
    const postPerPage = 10;
    const totalPages = Math.ceil(
        filtered.length / postPerPage
    );

    const start =
        (currentPage - 1) * postPerPage;

    const end = start + postPerPage;

    const filteredItem = filtered.slice(start, end);

    // Show current, previous and next page
    const pages = [
        currentPage - 1,
        currentPage,
        currentPage + 1,
    ].filter(
        (page) =>
            page > 0 &&
            page <= totalPages
    );

    // Start editing
    const handleEdit = (id, text) => {
        setEditId(id);
        setEditText(text);
    };

    // PATCH: Update todo
    const handleSave = (id) => {
        if (editText.trim() === "") return;

        axios
            .patch(
                `https://jsonplaceholder.typicode.com/todos/${id}`,
                {
                    title: editText,
                }
            )
            .then((res) => {
                setUser((prev) =>
                    prev.map((data) =>
                        data.id === id
                            ? {
                                  ...data,
                                  title: res.data.title,
                              }
                            : data
                    )
                );

                setEditId(null);
                setEditText("");
            })
            .catch((error) => {
                console.log(error);
            });
    };

    // Cancel editing
    const handleCancel = () => {
        setEditId(null);
        setEditText("");
    };

    if (loading) {
        return <h2>Loading...</h2>;
    }

    return (
        <div>
            <h2>Todo App</h2>

            <input
                placeholder="Search..."
                value={search}
                onChange={(e) => {
                    setSearch(e.target.value);
                    setCurrentPage(1);
                }}
            />

            <input
                placeholder="Add todo..."
                value={newItem}
                onChange={(e) =>
                    setNewItem(e.target.value)
                }
            />

            <button onClick={handleAdd}>
                Add
            </button>

            {filteredItem.length === 0 ? (
                <h2>No result</h2>
            ) : (
                <ul>
                    {filteredItem.map((data) => (
                        <li key={data.id}>

                            {data.id === editId ? (
                                <>
                                    <input
                                        value={editText}
                                        onChange={(e) =>
                                            setEditText(
                                                e.target.value
                                            )
                                        }
                                    />

                                    <button
                                        onClick={() =>
                                            handleSave(
                                                data.id
                                            )
                                        }
                                    >
                                        Save
                                    </button>

                                    <button
                                        onClick={handleCancel}
                                    >
                                        Cancel
                                    </button>
                                </>
                            ) : (
                                <>
                                    {data.title}

                                    <button
                                        onClick={() =>
                                            handleEdit(
                                                data.id,
                                                data.title
                                            )
                                        }
                                    >
                                        Edit
                                    </button>

                                    <button
                                        onClick={() =>
                                            handleDelete(
                                                data.id
                                            )
                                        }
                                    >
                                        Delete
                                    </button>
                                </>
                            )}

                        </li>
                    ))}
                </ul>
            )}

            {totalPages > 0 && (
                <div className="Pagination">

                    <button
                        disabled={currentPage === 1}
                        onClick={() =>
                            setCurrentPage(
                                (prev) => prev - 1
                            )
                        }
                    >
                        Prev
                    </button>

                    {pages.map((page) => (
                        <button
                            key={page}
                            onClick={() =>
                                setCurrentPage(page)
                            }
                        >
                            {page}
                        </button>
                    ))}

                    <button
                        disabled={
                            currentPage === totalPages
                        }
                        onClick={() =>
                            setCurrentPage(
                                (prev) => prev + 1
                            )
                        }
                    >
                        Next
                    </button>

                </div>
            )}
        </div>
    );
};

export default Api;
